# Copy this file to .env and fill values locally. Never put real values here or in Git.
# Gemini is used in later grounding and catalog steps.
GEMINI_API_KEY=

# Keep MOCK_BHASHINI=1 until you are ready to make real AnuvaadHub calls.
MOCK_BHASHINI=1

# AnuvaadHub credentials are separate per task and language/pair.
BHASHINI_ASR_EN_URL=
BHASHINI_ASR_EN_TOKEN=
BHASHINI_ASR_HI_URL=
BHASHINI_ASR_HI_TOKEN=
BHASHINI_ASR_TE_URL=
BHASHINI_ASR_TE_TOKEN=

BHASHINI_MT_EN_HI_URL=
BHASHINI_MT_EN_HI_TOKEN=
BHASHINI_MT_HI_EN_URL=
BHASHINI_MT_HI_EN_TOKEN=
BHASHINI_MT_EN_TE_URL=
BHASHINI_MT_EN_TE_TOKEN=
BHASHINI_MT_TE_EN_URL=
BHASHINI_MT_TE_EN_TOKEN=
BHASHINI_MT_HI_TE_URL=
BHASHINI_MT_HI_TE_TOKEN=
BHASHINI_MT_TE_HI_URL=
BHASHINI_MT_TE_HI_TOKEN=

BHASHINI_TTS_EN_URL=
BHASHINI_TTS_EN_TOKEN=
BHASHINI_TTS_HI_URL=
BHASHINI_TTS_HI_TOKEN=
BHASHINI_TTS_TE_URL=
BHASHINI_TTS_TE_TOKEN=

# Optional stretch feature: OCR endpoint and token.
BHASHINI_OCR_URL=
BHASHINI_OCR_TOKEN=
