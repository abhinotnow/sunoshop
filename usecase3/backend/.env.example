# Copy to backend/.env. Never commit backend/.env.

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models (checked on ai.google.dev/gemini-api/docs/models, 10 Oct 2026)
GEMINI_READER_MODEL=gemini-3.5-flash-lite
GEMINI_ARBITER_MODEL=gemini-3.5-flash-lite
GEMINI_ASK_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
# Measured 11 Oct 2026: gemini-3.7/3.8-flash timed out (>25 s); 3.5-flash-lite reads in 4-5 s.
GEMINI_TIMEOUT_S=12
# Reader 2: true = full sharpest frame, in parallel with reader 1 (faster); false = zoomed crop after reader 1
ARBITER_PARALLEL=true
# Image detail sent to Gemini (low|medium|high|ultra_high). ultra_high fixed Telugu letters like ఠ vs ట.
GEMINI_IMAGE_RESOLUTION=high
GEMINI_ARBITER_IMAGE_RESOLUTION=ultra_high
GEMINI_ARBITER_THINKING_LEVEL=low

# AnuvaadHub (Bhashini): endpoints + tokens go in backend/config/anuvaad.json
ANUVAAD_CONFIG=backend/config/anuvaad.json
# Their sample code disables certificate checks. If you see "TLS certificate check failed", set false.
ANUVAAD_VERIFY_TLS=true
TTS_GENDER=female

# Optional third reader (heavy install): pip install -r backend/requirements-ocr.txt
ENABLE_PADDLEOCR=false

MAX_READS_PER_SIGN=3
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*
